# Backend
DATABASE_URL=postgresql+psycopg://civilapp:civilapp@localhost:5432/civilapp
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Optional demo bootstrap. Keep real values only in hosting environment variables.
ENABLE_DEMO_SEED=false
BOOTSTRAP_INFRA_EMAIL=
BOOTSTRAP_INFRA_PASSWORD=
BOOTSTRAP_BUILD_EMAIL=
BOOTSTRAP_BUILD_PASSWORD=

# Frontend - required for public deployment
VITE_API_URL=http://localhost:8000
